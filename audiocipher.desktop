[Desktop Entry]
Version=1.0
Type=Application
Name=AudioCipher Studio
GenericName=Acoustic Steganography & Audio Cryptography Workstation
Comment=Acoustic Cryptography, High-Frequency Steganography, Audio Spectrogram Synthesis & FSK Modem
Exec=/usr/local/bin/audiocipher desktop
Icon=audiocipher
Terminal=false
Categories=AudioVideo;Security;Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open AudioCipher CLI
Exec=x-terminal-emulator -e "/usr/local/bin/audiocipher --help"

[Desktop Action Web]
Name=Open Web UI (Port 8096)
Exec=/usr/local/bin/audiocipher web
