[Desktop Entry]
Version=1.0
Type=Application
Name=AudioCipher Stego Studio
GenericName=Acoustic Cryptography & Steganography Workstation
Comment=Zero-egress acoustic cryptography, 16-bit PCM WAV LSB steganography, forensic steganalysis, DTMF Goertzel decoder, ITU Morse synthesizer, and ultrasonic BFSK air-gap modem.
Exec=/usr/local/bin/audiocipher-stego-engine desktop
TryExec=/usr/local/bin/audiocipher-stego-engine
Icon=audiocipher-stego-engine
Terminal=false
Categories=X-Zoth-Security;AudioVideo;Security;Development;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch AudioCipher Stego Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "AudioCipher Stego Studio TUI" -- /usr/local/bin/audiocipher-stego-engine-tui --watch

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8096)
Exec=xdg-open http://127.0.0.1:8096
