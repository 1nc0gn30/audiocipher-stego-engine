#!/usr/bin/env python3
"""AudioCipher Stego Studio (v2.6.0) — Live Loopback (:8096) Braille Telemetry TUI.

Queries real telemetry from 127.0.0.1:8096:
  /health and /api/diagnostics
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.request

VERSION = "2.6.0"
BRAILLE_BASE = 0x2800


def _fetch_json(port: int, path: str, timeout: float = 1.8) -> tuple[dict | None, float]:
    headers = {"Origin": f"http://127.0.0.1:{port}"}
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", headers=headers)
    t0 = time.perf_counter()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8")), elapsed_ms
    except Exception:
        pass
    return None, 0.0


def braille_sparkline(vals: list[float], width: int = 24) -> str:
    if not vals:
        vals = [0.0] * (width * 2)
    padded = list(vals[-(width * 2):])
    while len(padded) < width * 2:
        padded.insert(0, 0.0)
    out = []
    for i in range(0, len(padded) - 1, 2):
        v1 = max(0, min(3, int(padded[i] * 3.99)))
        v2 = max(0, min(3, int(padded[i + 1] * 3.99)))
        dots1 = (0x40, 0x04, 0x02, 0x01)[v1]
        dots2 = (0x80, 0x20, 0x10, 0x08)[v2]
        out.append(chr(BRAILLE_BASE | dots1 | dots2))
    return "".join(out)


def collect_snapshot(port: int, latency_history: list[float] | None = None) -> dict:
    health, health_ms = _fetch_json(port, "/health")
    diag, diag_ms = _fetch_json(port, "/api/diagnostics")
    online = health is not None

    history = list(latency_history or [])
    if online:
        history.append(min(1.0, max(0.08, health_ms / 50.0)))
    else:
        history.append(0.0)

    return {
        "tool": "audiocipher-stego-engine",
        "version": VERSION,
        "port": port,
        "online": online,
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "health": {
            "status": (health or {}).get("status", "offline"),
            "service": (health or {}).get("service", "audiocipher-stego-engine"),
            "version": (health or {}).get("version", VERSION),
            "uptime_seconds": float((health or {}).get("uptime_seconds", 0.0)),
            "probe_latency_ms": health_ms,
        },
        "diagnostics": {
            "status": (diag or {}).get("status", "OFFLINE"),
            "platform": (diag or {}).get("platform", sys.platform),
            "zero_dependencies": bool((diag or {}).get("zero_dependencies", True)),
            "crypto_format": (diag or {}).get("crypto_format", "v2-key-separated"),
            "pbkdf2_iterations": int((diag or {}).get("pbkdf2_iterations", 200000)),
            "max_body_bytes": int((diag or {}).get("max_body_bytes", 1572864)),
            "mcp_tools_count": int((diag or {}).get("mcp_tools_count", 9)),
            "probe_latency_ms": diag_ms,
        },
        "braille_latency_trace": braille_sparkline(history),
    }


def render_frame(snap: dict) -> str:
    h = snap["health"]
    d = snap["diagnostics"]
    state_tag = f"ONLINE (LIVE :{snap['port']} | {h['probe_latency_ms']}ms)" if snap["online"] else f"OFFLINE (:{snap['port']} idle)"
    uptime = f"{h['uptime_seconds']:.1f}s" if snap["online"] else "--"

    lines = [
        "\033[1;33m╭────────────────────────────────────────────────────────────────────────────╮\033[0m",
        f"\033[1;33m│\033[0m \033[1;37mAUDIOCIPHER STEGO STUDIO v{VERSION}\033[0m │ \033[36m{state_tag:<39}\033[0m \033[1;33m│\033[0m",
        "\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m",
        f"\033[1;33m│\033[0m Daemon     : State={d['status']:<8} | Uptime={uptime:<10} | ZeroDeps={str(d['zero_dependencies']):<5}      \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Crypto KDF : {d['crypto_format']:<18} | PBKDF2={d['pbkdf2_iterations']:,} rounds           \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Engine Bus : MCP Tools={d['mcp_tools_count']:<2} | MaxBody={d['max_body_bytes']:,} B | 16-bit PCM WAV   \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Probe Trace: \033[32m{snap['braille_latency_trace']}\033[0m  Loopback 127.0.0.1:{snap['port']}     \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Updated    : {snap['timestamp']:<22} │ Neal Frazier Tech • NullAI Platform \033[1;33m│\033[0m",
        "\033[1;33m╰────────────────────────────────────────────────────────────────────────────╯\033[0m",
    ]
    return "\n".join(lines)


def main() -> int:
    ap = argparse.ArgumentParser(description=f"AudioCipher Stego Studio v{VERSION} Live Braille TUI")
    ap.add_argument("--version", "-v", action="version", version=f"audiocipher-stego-engine-tui v{VERSION}")
    ap.add_argument("--port", "-p", type=int, default=int(os.environ.get("AUDIOCIPHER_PORT", "8096")), help="Daemon port (default: 8096)")
    ap.add_argument("--status", action="store_true", help="Print a single live telemetry status frame and exit")
    ap.add_argument("--json", action="store_true", help="Output live JSON telemetry snapshot and exit")
    ap.add_argument("--watch", action="store_true", help="Continuously refresh telemetry")
    ap.add_argument("--interval", type=float, default=1.5, help="Refresh interval seconds for --watch")
    args = ap.parse_args()

    if args.json:
        snap = collect_snapshot(args.port)
        print(json.dumps(snap, indent=2))
        return 0

    if not args.watch or args.status or not sys.stdout.isatty():
        snap = collect_snapshot(args.port)
        print(render_frame(snap))
        return 0

    history: list[float] = []
    try:
        while True:
            snap = collect_snapshot(args.port, history)
            history.append(min(1.0, max(0.08, snap["health"]["probe_latency_ms"] / 50.0)) if snap["online"] else 0.0)
            history = history[-48:]
            sys.stdout.write("\033[2J\033[H" + render_frame(snap) + "\nPress Ctrl+C to exit.\n")
            sys.stdout.flush()
            time.sleep(max(0.5, args.interval))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
